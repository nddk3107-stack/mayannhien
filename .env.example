# ============================================================================
# MÂY AN NHIÊN — cấu hình môi trường
# Copy file này thành `.env` rồi điền giá trị thật. `.env` KHÔNG được commit.
#   cp .env.example .env
#
# QUY TẮC: KHÔNG ghi secret nào vào file này, vào code, vào log hay báo cáo.
# Ô "placeholder" bên dưới là giá trị MẪU, không phải credential thật.
# ============================================================================

# ------------------------------------------------------------------ chung
# 'development' | 'production' — production bật cookie Secure + HSTS + mật khẩu chặt hơn.
NODE_ENV=development

# Port của API server (server.js), mặc định 3001.
PORT=3001

# Đường dẫn file SQLite. Để TRỐNG => <repo>/data/mayan.db (ổ đĩa bền vững).
# KHÔNG trỏ vào /tmp (dữ liệu sẽ mất khi reboot).
# DB_PATH=/var/lib/mayan/mayan.db

# Số reverse proxy đứng trước app (nginx = 1). KHÔNG đặt quá số thực tế:
# giá trị sai khiến client giả mạo được X-Forwarded-For -> vô hiệu hoá rate-limit.
# TRUST_PROXY_HOPS=0

# Base URL của API backend để frontend gọi khi deploy.
# - Để TRỐNG (khuyến nghị): frontend gọi cùng origin (/api/...) — frontend + API
#   nằm sau chung một reverse proxy.
# - Ví dụ tách riêng: VITE_API_BASE=https://api.mayan.example.com
VITE_API_BASE=

# Target proxy của Vite khi development (mặc định http://localhost:3001)
VITE_DEV_API=http://localhost:3001

# Danh sách domain được phép gọi API từ trình duyệt (CORS), phân tách bằng dấu phẩy.
# Để TRỐNG => chỉ cho phép cùng origin (an toàn nhất, khuyến nghị khi dùng 1 domain).
# ALLOWED_ORIGINS=https://mayan.example.com,https://www.mayan.example.com

# Phạm vi hiển thị đơn đặt của người dùng:
# - 'client' (mặc định): một tài khoản thấy đơn trên TRÌNH DUYỆN ĐÓ (khớp hành vi
#   lưu localStorage trước đây — mỗi trình duyệt mới bắt đầu với danh sách trống).
# - 'all': thấy toàn bộ đơn của tài khoản trên mọi thiết bị (cần đăng nhập lại).
# BOOKINGS_SCOPE=client

# Cho phép API nhập đơn cũ từ localStorage (chuyển dữ liệu từ bản demo).
# Production nên để 'false' sau khi đã nhập xong.
# ALLOW_LEGACY_IMPORT=false

# ------------------------------------------------------------------- MoMo
# MOMO_ENV: 'disabled' | 'sandbox' | 'production'
#   disabled   -> hệ thống dùng thanh toán MÔ PHỎNG (mặc định, an toàn).
#   sandbox    -> tích hợp MoMo sandbox (dùng để kiểm thử end-to-end).
#   production -> giao dịch thật, CHỈ dùng sau khi có credentials + phê duyệt.
MOMO_ENV=disabled

# Credentials do MoMo cấp — lấy từ https://developers.momo.vn (KHÔNG tự đặt).
# Để TRỐNG nếu chưa được cấp. Server tự phát hiện thiếu credential và tắt cổng.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Tên hiển thị trên trang thanh toán.
MOMO_PARTNER_NAME=MAY AN NHIÊN

# URL quay lại sau khi thanh toán (trang kết quả của website bạn) — BẮT BUỘC https ở production.
MOMO_RETURN_URL=

# URL nhận IPN/webhook từ MoMo — BẮT BUỘC https ở production, phải truy cập được từ Internet.
MOMO_IPN_URL=

# Cờ cho phép nhận TIỀN THẬT. Chỉ đặt 'true' khi đã hoàn tất checklist MoMo production.
# 'sandbox' KHÔNG BAO GIỜ được coi là tiền thật dù cờ này là true.
MOMO_ALLOW_LIVE=false

# Endpoint (để trống = dùng mặc định theo MOMO_ENV).
# MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
# MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query

# Phạm vi hiển thị đơn đặt của người dùng:
# - 'client' (mặc định): một tài khoản thấy đơn trên TRÌNH DUYỆN ĐÓ (khớp hành vi
#   lưu localStorage trước đây — mỗi trình duyệt mới bắt đầu với danh sách trống).
# - 'all': thấy toàn bộ đơn của tài khoản trên mọi thiết bị (cần đăng nhập lại).
# BOOKINGS_SCOPE=client