# Dịch vụ systemd cho backend Mây An Nhiên.
# Cài đặt:
#   sudo cp deploy/mayan-api.service /etc/systemd/system/mayan-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mayan-api
#   sudo systemctl status mayan-api
#
# LƯU Ý: thay User, WorkingDirectory, EnvironmentFile cho đúng máy chủ thật
# trước khi kích hoạt. File này KHÔNG chứa secret nào.

[Unit]
Description=Mây An Nhiên API (Node.js + Express + SQLite)
Documentation=file:/var/www/mayan/bao-cao/PRODUCTION_READINESS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User KHÔNG chạy bằng root — đây là user triển khai thường.
User=mayan
Group=mayan
WorkingDirectory=/var/www/mayan
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# Nạp biến môi trường (chứa secret) từ file RIÊNG, ngoài git, quyền 600.
EnvironmentFile=/etc/mayan/mayan.env
Environment=NODE_ENV=production
Environment=PORT=3001
# DB_PATH PHẢI nằm trong ReadWritePaths — ProtectSystem=strict biến /var/www thành
# read-only, nên DB mặc định (<repo>/data/mayan.db) sẽ KHÔNG ghi được.
Environment=DB_PATH=/var/lib/mayan/mayan.db

# Tăng cứng: không mở rộng quyền, không tạo core dump lộ dữ liệu.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mayan /var/log/mayan
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Giới hạn tài nguyên
LimitNOFILE=8192

# Log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mayan-api

[Install]
WantedBy=multi-user.target
